APP_NAME="BuffBridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1

# Customer authentication and session defaults
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Local development logs mail without delivering it. In production, replace
# MAIL_MAILER and the transport values with credentials from your provider.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="BuffBridge"
MAIL_EHLO_DOMAIN=

# Optional provider transports. Configure only the provider being used.
RESEND_KEY=
POSTMARK_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

QUEUE_CONNECTION=sync

GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Keep empty to serve shared public media from the current User host.
BLOG_MEDIA_URL=
BANNER_MEDIA_URL=
